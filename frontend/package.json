{
  "name": "@evora/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "generate:api": "openapi-typescript ../specs/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../specs/openapi.yaml -o src/api/schema.d.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-test.mjs && node --test test/*.test.mjs",
    "test:adaptive": "node test/adaptive.integration.mjs",
    "test:review-override": "node test/review-override.integration.mjs",
    "test:qa": "node test/qa-tracer.integration.mjs",
    "test:full-modality": "node test/full-modality.integration.mjs",
    "test:detector-feedback": "node test/detector-feedback.integration.mjs",
    "test:activity-browser": "node test/activity-center-browser.integration.mjs",
    "test:bulk-processing": "node test/bulk-processing.integration.mjs",
    "test:deeper-processing": "node test/deeper-processing.integration.mjs",
    "build": "npm run check:api && npm run typecheck && node scripts/build.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3"
  }
}
